<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ecnu.agentpapermate.mapper.PaperMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.ecnu.agentpapermate.entity.model.Paper">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="title" property="title" />
        <result column="authors" property="authors" />
        <result column="topic" property="topic" />
        <result column="abstract_text" property="abstractText" />
        <result column="original_filename" property="originalFilename" />
        <result column="file_hash" property="fileHash" />
        <result column="file_size" property="fileSize" />
        <result column="file_url" property="fileUrl" />
        <result column="page_count" property="pageCount" />
        <result column="status" property="status" />
        <result column="active_index_version" property="activeIndexVersion" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="is_recycled" property="isRecycled" />
        <result column="is_delete" property="isDelete" />
        <result column="active_index_attempt" property="activeIndexAttempt" />
    </resultMap>

    <select id="selectForLibraryIndex" resultMap="BaseResultMap" timeout="30">
        SELECT p.id, p.user_id, p.title, p.abstract_text, p.active_index_version, p.active_index_attempt
        FROM paper p
        JOIN app_user u ON u.id = p.user_id
        WHERE u.username = #{username}
          AND u.is_delete = 0
          AND p.is_delete = 0
          AND p.is_recycled = 0
          AND p.active_index_version IS NOT NULL
          AND p.active_index_attempt &lt;&gt; ''
          AND p.id IN
          <foreach collection="paperIds" item="paperId" open="(" separator="," close=")">
              #{paperId}
          </foreach>
    </select>

</mapper>
