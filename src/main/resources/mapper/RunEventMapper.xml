<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ecnu.agentpapermate.mapper.RunEventMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.ecnu.agentpapermate.entity.model.RunEvent">
        <id column="id" property="id" />
        <result column="run_id" property="runId" />
        <result column="event_seq" property="eventSeq" />
        <result column="event_type" property="eventType" />
        <result column="payload" property="payload" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="is_delete" property="isDelete" />
    </resultMap>

    <select id="selectAfterSequence" resultMap="BaseResultMap">
        SELECT * FROM run_event
        WHERE is_delete = 0 AND run_id = #{runId} AND event_seq &gt; #{after}
        ORDER BY event_seq ASC
        LIMIT #{limit}
    </select>
</mapper>
